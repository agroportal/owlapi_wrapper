        <AbbreviatedIRI>obo2:OAE_0000475</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">SIDER: C0003873</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="purl:Definition"/>
        <AbbreviatedIRI>obo2:OAE_0000476</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">an AE that occurs in immune system.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo2:IAO_0000116"/>
        <AbbreviatedIRI>obo2:OAE_0000476</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">According to the Vaccine Adverse Event Reporting System (VAERS), &apos;immune system disorder&apos; was mentioned in 292 VAERS reports (0.2%) during1991-2001 (Reference: PMID: 12825543).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo2:IAO_0000117"/>
        <AbbreviatedIRI>obo2:OAE_0000476</AbbreviatedIRI>
