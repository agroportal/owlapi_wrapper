    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo2:IAO_0000119"/>
        <AbbreviatedIRI>obo2:OAE_0000635</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">WEB: http://www.fda.gov/Safety/MedWatch/HowToReport/ucm053087.htm</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>obo2:OAE_0000635</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">adverse event leading to disability</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="purl:Definition"/>
        <AbbreviatedIRI>obo2:OAE_0000636</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">a serious adverse event that is an adverse event leading to congenital anomaly leads to suspicions that exposure to a medical product prior to conception or during pregnancy resulted in an adverse outcome in the child.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo2:IAO_0000117"/>
        <AbbreviatedIRI>obo2:OAE_0000636</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">YH</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo2:IAO_0000119"/>
        <AbbreviatedIRI>obo2:OAE_0000636</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">WEB: http://www.fda.gov/Safety/MedWatch/HowToReport/ucm053087.htm</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo2:IAO_0000119"/>
        <AbbreviatedIRI>obo2:OAE_0000636</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">WEB: http://www.thefreedictionary.com/birth+defect</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
