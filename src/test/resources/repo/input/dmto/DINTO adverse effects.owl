        <AnnotationProperty abbreviatedIRI="purl:Definition"/>
        <AbbreviatedIRI>obo2:OAE_0001983</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">Hyperthermia AE is an abnormal body temperature AE that is elevated body temperature due to failed thermoregulation that occurs when a body produces or absorbs more heat than it dissipates. Extreme temperature elevation then becomes a medical emergency requiring immediate treatment to prevent disability or death.</Literal>
    </AnnotationAssertion>
