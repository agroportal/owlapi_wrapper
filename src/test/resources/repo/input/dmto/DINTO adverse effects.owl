        <AnnotationProperty abbreviatedIRI="purl:Definition"/>
        <AbbreviatedIRI>obo2:OAE_0002499</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">A disseminated tuberculosis AE is a tuberculosis AE that has an outcome of disseminated tuberculosis, which is a contagious bacterial infection in which TB bacteria has spread from the lungs to other parts of the body through the blood or lymph system.</Literal>
    </AnnotationAssertion>
