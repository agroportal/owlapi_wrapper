        <AnnotationProperty abbreviatedIRI="purl:Definition"/>
        <AbbreviatedIRI>obo2:OAE_0001936</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">Acute bronchitis AE is a bronchitis AE that is an inflammation of the large bronchi (medium-size airways) in the lungs that is usually caused by viruses or bacteria and may last several days or weeks. Characteristic symptoms include cough, sputum (phlegm) production, and shortness of breath and wheezing related to the obstruction of the inflamed airways.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo2:IAO_0000117"/>
        <AbbreviatedIRI>obo2:OAE_0001936</AbbreviatedIRI>
