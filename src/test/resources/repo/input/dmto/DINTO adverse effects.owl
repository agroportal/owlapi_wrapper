    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo2:IAO_0000118"/>
        <AbbreviatedIRI>obo2:OAE_0000444</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">Autism is a brain development disorder characterized by impaired social interaction and communication, and by restricted and repetitive behavior.</Literal>
