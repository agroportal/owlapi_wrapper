        <AbbreviatedIRI>obo2:OAE_0000634</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">a serious adverse event that leads to hospitalization. </Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
