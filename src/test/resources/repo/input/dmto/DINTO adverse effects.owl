    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="purl:Definition"/>
        <AbbreviatedIRI>obo2:OAE_0002494</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">diabetic ketoacidosis AE  is a cardiovascular AE that develops when your body is unable to produce enough insulin and begins to break down fat as an alternate fuel, this process produces a buildup of toxic acids in the bloodstream called ketones. </Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo2:IAO_0000117"/>
        <AbbreviatedIRI>obo2:OAE_0002494</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">SJ, YH</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo2:IAO_0000119"/>
        <AbbreviatedIRI>obo2:OAE_0002494</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">WEB: http://www.mayoclinic.org/diseases-conditions/diabetic-ketoacidosis/basics/definition/con-20026470</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
