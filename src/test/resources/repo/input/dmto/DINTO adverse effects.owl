        <AbbreviatedIRI>obo2:OAE_0002105</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">peritendinitis symptom AE</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="purl:Definition"/>
        <AbbreviatedIRI>obo2:OAE_0002106</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">Orthostatic hypotension AE is a hypotension AE that is a form of hypotension in which a person&apos;s blood pressure falls when suddenly standing up or stretching. In medical terms, it is defined as a fall in systolic blood pressure of at least 20 mm Hg or diastolic blood pressure of at least 10 mm Hg when a person assumes a standing position.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo2:IAO_0000117"/>
