    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="purl:Definition"/>
        <AbbreviatedIRI>obo2:OAE_0001760</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">a thrombosis AE that is a rare lesion and may be defined as a thrombosis of a vessel without any obvious underlying cause that occurs in the aorta</Literal>
    </AnnotationAssertion>
