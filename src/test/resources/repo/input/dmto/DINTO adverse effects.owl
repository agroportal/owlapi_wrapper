        <AnnotationProperty abbreviatedIRI="purl:Definition"/>
        <AbbreviatedIRI>obo2:OAE_0000489</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">a skin adverse event that has an outcome of skin striae that displays irregular areas of skin that look like bands, stripes, or lines. Striae are seen when a person grows or gains weight rapidly or has certain diseases or conditions.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
