    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo2:IAO_0000116"/>
        <AbbreviatedIRI>obo2:OAE_0000522</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">A tendon (or sinew) is a tough band of fibrous connective tissue that usually connects muscle to bone and is capable of withstanding tension.</Literal>
    </AnnotationAssertion>
