        <AnnotationProperty abbreviatedIRI="purl:Definition"/>
        <AbbreviatedIRI>obo2:OAE_0002585</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">a cardiac disorder AE that can present clinically as acute pericarditis, pericardial effusion, cardiac tamponade, and constrictive pericarditis.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
