        <Literal datatypeIRI="&rdf;PlainLiteral">sudden adult death syndrome (SADS)</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo2:IAO_0000119"/>
        <AbbreviatedIRI>obo2:OAE_0002452</AbbreviatedIRI>
