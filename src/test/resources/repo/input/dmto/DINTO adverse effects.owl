        <Literal datatypeIRI="&rdf;PlainLiteral">NCIT: C61240</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="purl:Definition"/>
        <AbbreviatedIRI>obo2:OAE_0002591</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">a immune system AE that results in a state in which the immune system&apos;s ability to fight infectious disease is compromised or entirely absent.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
