        <AbbreviatedIRI>obo2:OAE_0000027</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">WEB: http://www.cdc.gov/niosh/programs/msd/</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>obo2:OAE_0000027</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">A musculoskeletal disorder is an injury or disorder of the muscles, nerves, tendons, joints, cartilage, or supporting structures of the upper or lower limbs, neck, or lower back that are caused, precipitated, or exacerbated by sudden exertion or prolonged exposure to physical factors such as repetition, force, vibration, or awkward posture</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
