        <AbbreviatedIRI>obo2:OAE_0002453</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">Butt Pain </Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
