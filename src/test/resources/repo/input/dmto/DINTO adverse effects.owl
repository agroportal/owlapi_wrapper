        <Literal datatypeIRI="&rdf;PlainLiteral">a sensory capability AE that has an outcome of dizziness</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo2:IAO_0000117"/>
        <AbbreviatedIRI>obo2:OAE_0000388</AbbreviatedIRI>
