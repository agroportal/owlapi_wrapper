        <AbbreviatedIRI>obo2:OAE_0000315</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">WEB: http://medical-dictionary.thefreedictionary.com/right+bundle+branch+block</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
