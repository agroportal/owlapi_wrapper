    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="purl:Definition"/>
        <AbbreviatedIRI>obo2:OAE_0002361</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">APGAR is a quick test performed on a neonate at 1 and 5 minutes after birth. The 1-minute score determines how well the baby tolerated the birthing process. The 5-minute score tells the doctor how well the baby is doing outside the mother&apos;s womb. Any score lower than 7 is a sign that the baby needs medical attention. The lower the score, the more help the baby needs to adjusting outside the mother&apos;s womb</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo2:IAO_0000117"/>
        <AbbreviatedIRI>obo2:OAE_0002361</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">YH, SJ </Literal>
    </AnnotationAssertion>
