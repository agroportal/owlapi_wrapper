    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="purl:Definition"/>
        <AbbreviatedIRI>obo2:OAE_0002586</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">a tumor AE that shows a benign or malignant neoplasm that affects the peritoneal cavity.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo2:IAO_0000117"/>
        <AbbreviatedIRI>obo2:OAE_0002586</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">KM, YH</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo2:IAO_0000119"/>
        <AbbreviatedIRI>obo2:OAE_0002586</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">WEB: http://www.webmd.com/cancer/peritoneal-cancer-prognosis-symptoms-treatments</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>obo2:OAE_0002586</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">Representative examples of benign neoplasms include adenomatoid tumor and disseminated peritoneal leiomyomatosis. Representative examples of malignant neoplasms include primary peritoneal carcinoma, metastatic carcinoma to the peritoneum, and malignant mesothelioma.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>obo2:OAE_0002586</AbbreviatedIRI>
        <Literal xml:lang="en" datatypeIRI="&rdf;PlainLiteral">peritoneal neoplasm AE</Literal>
