        <Literal datatypeIRI="&rdf;PlainLiteral">a behavior and neurological AE that has an outcome of amnesia in a patient</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo2:IAO_0000117"/>
        <AbbreviatedIRI>obo2:OAE_0000482</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">YH</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>obo2:OAE_0000482</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">Amnesia is a short term memory condition in which memory is disturbed. In simple terms it is the loss of memory.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>obo2:OAE_0000482</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">amnesia AE</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:seeAlso"/>
        <AbbreviatedIRI>obo2:OAE_0000482</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">HPO: HP_0002354</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
