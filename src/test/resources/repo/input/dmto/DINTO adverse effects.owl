        <Literal datatypeIRI="&rdf;PlainLiteral">WEB: http://www.ncbi.nlm.nih.gov/pmc/articles/PMC2878263/</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>obo2:OAE_0002585</AbbreviatedIRI>
        <Literal xml:lang="en" datatypeIRI="&rdf;PlainLiteral">pericardial disease AE</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:seeAlso"/>
        <AbbreviatedIRI>obo2:OAE_0002585</AbbreviatedIRI>
