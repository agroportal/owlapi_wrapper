        <AbbreviatedIRI>obo2:OAE_0000630</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">MedDRA ID: 10014080</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
