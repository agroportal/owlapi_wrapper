    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo2:IAO_0000116"/>
        <AbbreviatedIRI>obo2:OAE_0000527</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">According to the Vaccine Adverse Event Reporting System (VAERS), &apos;hemiplegia&apos;; is an adverse event that was mentioned in 129 VAERS reports (0.1%) during1991-2001 (Reference: PMID: 12825543).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo2:IAO_0000117"/>
        <AbbreviatedIRI>obo2:OAE_0000527</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">YH</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>obo2:OAE_0000527</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">Hemiplegia is total paralysis of the arm, leg, and trunk on the same side of the body. Hemiplegia is more severe than hemiparesis, wherein one half of the body is weakened but not paralysed.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
