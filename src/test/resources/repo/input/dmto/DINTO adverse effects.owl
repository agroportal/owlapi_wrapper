    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>obo2:OAE_0000508</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">Epistaxis is the relatively common occurrence of hemorrhage from the nose, usually noticed when the blood drains out through the nostrils.</Literal>
