    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo2:IAO_0000116"/>
        <AbbreviatedIRI>obo2:OAE_0000030</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">YH: This term is just used as an example of vaccine induced adverse events. Specific vaccine-associated and vaccine-induced adverse events are now represented with the Ontology of Vaccine Adverse Events (OVAE).: http://www.violinet.org/ovae/. </Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
