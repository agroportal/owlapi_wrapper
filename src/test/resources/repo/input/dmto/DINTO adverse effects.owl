    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="purl:Definition"/>
        <AbbreviatedIRI>obo2:OAE_0001937</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">Renal calculus AE is a kidney AE that is a solid concretion or crystal aggregation formed in the kidneys from minerals in the urine. Kidney stones typically leave the body by passage in the urine stream, and many stones are formed and passed without causing symptoms. If stones grow to sufficient size (usually at least 3 millimeters (0.12 in)) they can cause blockage of the ureter. This leads to pain, most commonly beginning in the flank or lower back and often radiating to the groin or genitals.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo2:IAO_0000117"/>
        <AbbreviatedIRI>obo2:OAE_0001937</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">JX, LW, YH</Literal>
    </AnnotationAssertion>
