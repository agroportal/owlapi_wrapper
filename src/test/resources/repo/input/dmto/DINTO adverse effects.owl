        <AbbreviatedIRI>obo2:OAE_0000482</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">MedDRA ID: 10001949</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:seeAlso"/>
