    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="purl:Definition"/>
        <AbbreviatedIRI>obo2:OAE_0002017</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">Methemoglobinemia AE is a red blood cell profile abnormal AE that is a disorder characterized by the presence of a higher than normal level of methemoglobin (metHb, i.e., ferric [Fe3+] rather than ferrous [Fe2+] haemoglobin) in the blood. It&apos;s a form of hemoglobin that contains ferric [Fe3+] iron and has a decreased ability to bind oxygen.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
