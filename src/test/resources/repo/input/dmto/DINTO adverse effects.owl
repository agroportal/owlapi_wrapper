        <AnnotationProperty abbreviatedIRI="purl:Definition"/>
        <AbbreviatedIRI>obo2:OAE_0001981</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">ST segment depression AE is an electrocardiogram result abnormal AE that refers to a finding on an electrocardiogram. It may be determined by measuring the vertical distance between the patient&apos;s trace and the isoelectric line at a location 2-3 millimeters from the QRS complex. It is significant if it is more than 1 mm in V5-V6, or 1.5 mm in AVF or III.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo2:IAO_0000117"/>
