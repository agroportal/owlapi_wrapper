    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="purl:Definition"/>
        <AbbreviatedIRI>obo2:OAE_0000459</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">a neurological, special senses and psychiatric investigation result abnormal AE that is the abnormal result of a procedure that uses small, flat metal discs (electrodes) attached to your scalp to detect electrical activity in your brain</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo2:IAO_0000116"/>
        <AbbreviatedIRI>obo2:OAE_0000459</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;abnormal electroencephalogram&apos; is an adverse event that was mentioned in 420 VAERS reports (0.3%) during1991-2001 (Reference: PMID: 12825543).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo2:IAO_0000117"/>
        <AbbreviatedIRI>obo2:OAE_0000459</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">YH, EB</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo2:IAO_0000119"/>
