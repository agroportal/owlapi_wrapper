        <AbbreviatedIRI>obo2:OAE_0000392</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">a sensory neuropathy AE that shows a sensation of tingling, pricking, or numbness of a person&apos;s skin with no apparent long-term physical effect.</Literal>
    </AnnotationAssertion>
