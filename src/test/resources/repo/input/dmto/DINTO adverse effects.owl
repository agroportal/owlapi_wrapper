        <AbbreviatedIRI>obo2:OAE_0000659</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">an arrhythmia AE that involves the two upper chambers (atria) of the heart</Literal>
    </AnnotationAssertion>
