        <AbbreviatedIRI>obo2:OAE_0002449</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">URL: http://medical-dictionary.thefreedictionary.com/myocardial+necrosis</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>obo2:OAE_0002449</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">myocardial necrosis AE</Literal>
    </AnnotationAssertion>
