        <AbbreviatedIRI>obo2:OAE_0000453</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">MedDRA: 10013946</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
