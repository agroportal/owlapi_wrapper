        <AbbreviatedIRI>obo2:OAE_0000514</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">According to the Vaccine Adverse Event Reporting System (VAERS), &apos;neuralgia&apos;; is an adverse event that was mentioned in 155 VAERS reports (0.1%) during1991-2001 (Reference: PMID: 12825543).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo2:IAO_0000117"/>
        <AbbreviatedIRI>obo2:OAE_0000514</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">YH</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>obo2:OAE_0000514</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">Neuralgia or neuropathic pain can be defined most simply as non-nociceptive pain. Neuralgia is pain produced by a change in neurological structure or function. Unlike nociceptive pain, Neuralgia exists with no continuous nociceptive input. Neuralgia falls into two categories: central Neuralgia and peripheral Neuralgia.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>obo2:OAE_0000514</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">neuralgia AE</Literal>
    </AnnotationAssertion>
