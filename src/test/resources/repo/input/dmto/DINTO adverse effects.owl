    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>obo2:OAE_0000462</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">Bronchitis is an inflammation of the air passages within the lungs. It occurs when the trachea (windpipe) and the large and small bronchi (airways) within the lungs become inflamed because of infection or other causes.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>obo2:OAE_0000462</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">bronchitis AE</Literal>
