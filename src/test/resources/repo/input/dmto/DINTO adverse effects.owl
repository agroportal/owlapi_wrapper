        <AnnotationProperty abbreviatedIRI="purl:Definition"/>
        <AbbreviatedIRI>obo2:OAE_0002589</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">a tumor AE that shows the most common benign spinal neoplasm, often located in the thoracic and lumbar spine, with a peak incidence of occurrence in the fourth to sixth decades.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo2:IAO_0000117"/>
        <AbbreviatedIRI>obo2:OAE_0002589</AbbreviatedIRI>
