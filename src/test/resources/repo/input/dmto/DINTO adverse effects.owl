        <AnnotationProperty abbreviatedIRI="obo2:IAO_0000116"/>
        <AbbreviatedIRI>obo2:OAE_0000522</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">According to the Vaccine Adverse Event Reporting System (VAERS), &apos;tendon disorder&apos;; is an adverse event that was mentioned in 137 VAERS reports (0.1%) during1991-2001 (Reference: PMID: 12825543).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
