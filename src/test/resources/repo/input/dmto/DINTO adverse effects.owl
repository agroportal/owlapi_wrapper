        <Literal datatypeIRI="&rdf;PlainLiteral">WEB: http://www.fda.gov/Safety/MedWatch/HowToReport/ucm053087.htm</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>obo2:OAE_0000634</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">adverse event leading to hospitalization</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="purl:Definition"/>
        <AbbreviatedIRI>obo2:OAE_0000635</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">a serious adverse event that leads to disability or permanent damage. </Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
