        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <AbbreviatedIRI>skos:editorialNote</AbbreviatedIRI>
        <Literal xml:lang="en" datatypeIRI="&rdf;PlainLiteral">A note for an editor, translator or maintainer of the vocabulary.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>skos:example</AbbreviatedIRI>
