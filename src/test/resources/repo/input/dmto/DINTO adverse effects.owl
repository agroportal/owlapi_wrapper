        <Literal datatypeIRI="&rdf;PlainLiteral">a behavior and neurological AE that has an outcome of stupor</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo2:IAO_0000117"/>
