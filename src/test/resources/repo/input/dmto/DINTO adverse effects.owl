        <AbbreviatedIRI>obo2:OAE_0000429</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">WEB: http://www.ncbi.nlm.nih.gov/pubmed/23299621</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>obo2:OAE_0000429</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">Guillain-Barre syndrome AE</Literal>
