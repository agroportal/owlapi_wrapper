    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>obo2:OAE_0000391</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">Somnolence (or &quot;drowsiness&quot;) is a state of near-sleep, a strong desire for sleep, or sleeping for unusually long periods (c.f. hypersomnia).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
