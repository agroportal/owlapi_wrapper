        <AbbreviatedIRI>obo2:OAE_0002105</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">腱鞘炎样症状</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
