        <AbbreviatedIRI>obo2:OAE_0000475</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">rheumatoid arthritis AE</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:seeAlso"/>
        <AbbreviatedIRI>obo2:OAE_0000475</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">HPO: HP_0005681</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
