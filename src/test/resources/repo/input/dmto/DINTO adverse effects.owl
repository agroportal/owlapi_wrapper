        <AbbreviatedIRI>obo2:OAE_0002496</AbbreviatedIRI>
        <Literal xml:lang="en" datatypeIRI="&rdf;PlainLiteral">congenital diaphragmatic hernia AE</Literal>
    </AnnotationAssertion>
