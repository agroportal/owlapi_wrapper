    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo2:IAO_0000118"/>
        <AbbreviatedIRI>obo2:OAE_0000476</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">immune system disorder AE</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>obo2:OAE_0000476</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">immune system AE</Literal>
    </AnnotationAssertion>
