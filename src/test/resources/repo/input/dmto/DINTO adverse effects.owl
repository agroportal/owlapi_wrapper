        <AbbreviatedIRI>obo2:OAE_0000632</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">SIDER: C1306577</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="purl:Definition"/>
        <AbbreviatedIRI>obo2:OAE_0000633</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">a serious adverse event that is life-threatening. This adverse event occurs when a patient was at substantial risk of dying or it is suspected that the use or continued use of the product would result in the patient&apos;s death.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo2:IAO_0000117"/>
        <AbbreviatedIRI>obo2:OAE_0000633</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">YH</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
