        <Literal datatypeIRI="&rdf;PlainLiteral">a sensory capability AE that has an outcome of hallucination</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo2:IAO_0000117"/>
        <AbbreviatedIRI>obo2:OAE_0000512</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">YH</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>obo2:OAE_0000512</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">A hallucination, in the broadest sense, is a perception in the absence of a stimulus. In a stricter sense, hallucinations are defined as perceptions in a conscious and awake state in the absence of external stimuli which have qualities of real perception, in that they are vivid, substantial, and located in external objective space.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>obo2:OAE_0000512</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">hallucination AE</Literal>
