    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="purl:Definition"/>
        <AbbreviatedIRI>obo2:OAE_0000510</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">an eye disorder AE which has an outcome of photophobia</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo2:IAO_0000117"/>
        <AbbreviatedIRI>obo2:OAE_0000510</AbbreviatedIRI>
