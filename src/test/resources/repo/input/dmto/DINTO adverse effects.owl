        <AnnotationProperty abbreviatedIRI="purl:Definition"/>
        <AbbreviatedIRI>obo2:OAE_0002449</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">Myocardial necrosis AE is a cardiac disorder AE that shows death of the cells of an area of the heart muscle (myocardium) as a result of oxygen deprivation, which in turn is caused by obstruction of the blood supply.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo2:IAO_0000117"/>
        <AbbreviatedIRI>obo2:OAE_0002449</AbbreviatedIRI>
