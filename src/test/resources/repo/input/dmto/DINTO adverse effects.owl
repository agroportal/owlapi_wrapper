    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>obo2:OAE_0000507</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">Thrombocythemia (primary thrombocythemia) is a disorder in which excess platelets are produced, leading to abnormal blood clotting or bleeding.</Literal>
    </AnnotationAssertion>
