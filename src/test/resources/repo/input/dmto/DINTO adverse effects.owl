        <Literal datatypeIRI="&rdf;PlainLiteral">WEB: http://en.wikipedia.org/wiki/Atrial_fibrillation</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo2:IAO_0000119"/>
        <AbbreviatedIRI>obo2:OAE_0000659</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">WEB: http://medical-dictionary.thefreedictionary.com/atrial+fibrillation</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>obo2:OAE_0000659</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">Atrial fibrillation (AF or A-fib) is the most common cardiac arrhythmia (abnormal heart rhythm), and involves the two upper chambers (atria) of the heart. Its name comes from the fibrillating (i.e., quivering) of the heart muscles of the atria, instead of a coordinated contraction.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>obo2:OAE_0000659</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">atrial fibrillation AE</Literal>
