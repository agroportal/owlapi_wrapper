    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="purl:Definition"/>
        <AbbreviatedIRI>obo2:OAE_0000453</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">an abnormal digestion AE which has an outcome of dyspepsia</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo2:IAO_0000116"/>
        <AbbreviatedIRI>obo2:OAE_0000453</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;dyspepsia&apos; is an adverse event that was mentioned in 454 VAERS reports (0.4%) during1991-2001 (Reference: PMID: 12825543).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo2:IAO_0000117"/>
        <AbbreviatedIRI>obo2:OAE_0000453</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">YH</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>obo2:OAE_0000453</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">Dyspepsia is popularly known as indigestion, meaning hard or difficult digestion. It is a medical condition characterized by chronic or recurrent pain in the upper abdomen, upper abdominal fullness and feeling full earlier than expected when eating.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>obo2:OAE_0000453</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">dyspepsia AE</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:seeAlso"/>
        <AbbreviatedIRI>obo2:OAE_0000453</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">HPO: HP_0002577</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:seeAlso"/>
        <AbbreviatedIRI>obo2:OAE_0000453</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">MedDRA ID: 10013946</Literal>
    </AnnotationAssertion>
