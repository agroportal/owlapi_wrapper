        <AbbreviatedIRI>obo2:OAE_0002590</AbbreviatedIRI>
        <Literal xml:lang="en" datatypeIRI="&rdf;PlainLiteral">Omenn syndrome AE</Literal>
    </AnnotationAssertion>
