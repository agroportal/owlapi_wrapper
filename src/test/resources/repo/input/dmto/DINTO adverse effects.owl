    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="purl:Definition"/>
        <AbbreviatedIRI>obo2:OAE_0000509</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">a syndrome AE that displays a lupus syndrome. Lupus is an autoimmune disease where the body&apos;s immune system becomes hyperactive and attacks normal, healthy tissue. This results in symptoms such as inflammation, swelling, and damage to joints, skin, kidneys, blood, the heart, and lungs.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo2:IAO_0000117"/>
