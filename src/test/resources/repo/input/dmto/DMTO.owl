        <AnnotationProperty abbreviatedIRI="obo:IAO_0000112"/>
        <AbbreviatedIRI>obo:IAO_0000596</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">Ontology: &lt;http://purl.obolibrary.org/obo/ro/idrange/&gt;
  Annotations: 
     &apos;has ID prefix&apos;: &quot;http://purl.obolibrary.org/obo/RO_&quot;
     &apos;has ID digit count&apos; : 7,
     rdfs:label &quot;RO id policy&quot;
     &apos;has ID policy for&apos;: &quot;RO&quot;</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000115"/>
        <AbbreviatedIRI>obo:IAO_0000596</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">Relates an ontology used to record id policy to the number of digits in the URI. The URI is: the &apos;has ID prefix&quot; annotation property value concatenated with an integer in the id range (left padded with &quot;0&quot;s to make this many digits)</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
