    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000115"/>
        <AbbreviatedIRI>obo:IAO_0000234</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">The name of the person, project, or organization that motivated inclusion of an ontology term by requesting its addition.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000117"/>
        <AbbreviatedIRI>obo:IAO_0000234</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">Person: Jie Zheng, Chris Stoeckert, Alan Ruttenberg</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
