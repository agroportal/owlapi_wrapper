        </Annotation>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000600"/>
        <AbbreviatedIRI>obo:BFO_0000011</AbbreviatedIRI>
        <Literal xml:lang="en" datatypeIRI="&rdf;PlainLiteral">A spatiotemporal region is an occurrent entity that is part of spacetime. (axiom label in BFO2 Reference: [095-001])</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <Annotation>
            <AnnotationProperty abbreviatedIRI="obo:IAO_0010000"/>
            <AbbreviatedIRI>obo:bfo/axiom/096-001</AbbreviatedIRI>
        </Annotation>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000601"/>
        <AbbreviatedIRI>obo:BFO_0000011</AbbreviatedIRI>
        <Literal xml:lang="en" datatypeIRI="&rdf;PlainLiteral">All parts of spatiotemporal regions are spatiotemporal regions. (axiom label in BFO2 Reference: [096-001])</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
