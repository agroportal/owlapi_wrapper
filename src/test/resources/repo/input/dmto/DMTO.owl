        <AbbreviatedIRI>obo:BFO_0000018</AbbreviatedIRI>
        <Literal xml:lang="en" datatypeIRI="&rdf;PlainLiteral">zero-dimensional spatial region</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="metadata:prefixIRI"/>
        <AbbreviatedIRI>obo:BFO_0000019</AbbreviatedIRI>
        <Literal datatypeIRI="&xsd;string">BFO:0000019</Literal>
    </AnnotationAssertion>
