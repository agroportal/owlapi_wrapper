        <Literal datatypeIRI="&rdf;PlainLiteral">Person: Jie Zheng, Chris Stoeckert, Alan Ruttenberg</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>obo:IAO_0000234</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">The &apos;term requester&apos; can credit the person, organization or project who request the ontology term.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>obo:IAO_0000234</AbbreviatedIRI>
        <Literal xml:lang="en" datatypeIRI="&rdf;PlainLiteral">ontology term requester</Literal>
