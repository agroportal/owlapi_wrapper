        <Literal xml:lang="en" datatypeIRI="&rdf;PlainLiteral">an infinitely thin plane in space.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000112"/>
        <AbbreviatedIRI>obo:BFO_0000009</AbbreviatedIRI>
        <Literal xml:lang="en" datatypeIRI="&rdf;PlainLiteral">the surface of a sphere-shaped part of space</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <Annotation>
            <AnnotationProperty abbreviatedIRI="obo:IAO_0010000"/>
            <AbbreviatedIRI>obo:bfo/axiom/039-001</AbbreviatedIRI>
        </Annotation>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000600"/>
        <AbbreviatedIRI>obo:BFO_0000009</AbbreviatedIRI>
        <Literal xml:lang="en" datatypeIRI="&rdf;PlainLiteral">A two-dimensional spatial region is a spatial region that is of two dimensions. (axiom label in BFO2 Reference: [039-001])</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <Annotation>
            <AnnotationProperty abbreviatedIRI="obo:IAO_0010000"/>
            <AbbreviatedIRI>obo:bfo/axiom/039-001</AbbreviatedIRI>
        </Annotation>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000602"/>
        <AbbreviatedIRI>obo:BFO_0000009</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">(forall (x) (if (TwoDimensionalSpatialRegion x) (SpatialRegion x))) // axiom label in BFO2 CLIF: [039-001] </Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>obo:BFO_0000009</AbbreviatedIRI>
        <AbbreviatedIRI>obo:bfo.owl</AbbreviatedIRI>
