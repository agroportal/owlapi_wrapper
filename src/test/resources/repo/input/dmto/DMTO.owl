        <AbbreviatedIRI>obo:IAO_0000596</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">Person:Alan Ruttenberg</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
