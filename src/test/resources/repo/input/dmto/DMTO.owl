        <AbbreviatedIRI>obo:BFO_0000009</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">2d-s-region</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:BFO_0000180"/>
        <AbbreviatedIRI>obo:BFO_0000009</AbbreviatedIRI>
        <Literal datatypeIRI="&rdf;PlainLiteral">TwoDimensionalSpatialRegion</Literal>
    </AnnotationAssertion>
