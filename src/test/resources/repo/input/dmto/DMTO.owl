    <Annotation>
        <AnnotationProperty IRI="http://www.co-ode.org/ontologies/ont.owl#DDO:0000002"/>
        <Literal datatypeIRI="&xsd;string">Shaker El-Sappagh</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="protege:defaultLanguage"/>
        <Literal datatypeIRI="&xsd;string">en</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <Literal xml:lang="en" datatypeIRI="&rdf;PlainLiteral"></Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000115"/>
        <Literal datatypeIRI="&xsd;string">DMTO is an OWL 2 ontology for creating customized treatment plans for diabetic patients. The ontology is based on BFO and OGMS. In addition, it extends the DDO ontology by adding the treatment classes and axioms to the existing diagnosis part. </Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="dc:date"/>
        <Literal datatypeIRI="&xsd;dateTime">2017-3-27</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="owl:versionInfo"/>
        <Literal datatypeIRI="&rdf;PlainLiteral">1.0</Literal>
    </Annotation>
