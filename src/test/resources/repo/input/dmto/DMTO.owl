    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="dc:description"/>
        <AbbreviatedIRI>dc:contributor</AbbreviatedIRI>
        <Literal xml:lang="en-us" datatypeIRI="&rdf;PlainLiteral">Examples of a Contributor include a person, an 
         organisation, or a service.  Typically, the name of a 
         Contributor should be used to indicate the entity.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>dc:contributor</AbbreviatedIRI>
        <Literal xml:lang="en-us" datatypeIRI="&rdf;PlainLiteral">An entity responsible for making contributions to the
         content of the resource.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>dc:contributor</AbbreviatedIRI>
        <AbbreviatedIRI>dc:</AbbreviatedIRI>
