        <Literal datatypeIRI="&rdf;PlainLiteral">ObjectAggregate</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000112"/>
        <AbbreviatedIRI>obo:BFO_0000027</AbbreviatedIRI>
        <Literal xml:lang="en" datatypeIRI="&rdf;PlainLiteral">a collection of cells in a blood biobank.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000112"/>
        <AbbreviatedIRI>obo:BFO_0000027</AbbreviatedIRI>
        <Literal xml:lang="en" datatypeIRI="&rdf;PlainLiteral">a swarm of bees is an aggregate of members who are linked together through natural bonds</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000112"/>
        <AbbreviatedIRI>obo:BFO_0000027</AbbreviatedIRI>
        <Literal xml:lang="en" datatypeIRI="&rdf;PlainLiteral">a symphony orchestra</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000112"/>
        <AbbreviatedIRI>obo:BFO_0000027</AbbreviatedIRI>
        <Literal xml:lang="en" datatypeIRI="&rdf;PlainLiteral">an organization is an aggregate whose member parts have roles of specific types (for example in a jazz band, a chess club, a football team)</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
