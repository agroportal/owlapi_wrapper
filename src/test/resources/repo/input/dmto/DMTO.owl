        <AbbreviatedIRI>obo:BFO_0000011</AbbreviatedIRI>
        <Literal xml:lang="en" datatypeIRI="&rdf;PlainLiteral">Every spatiotemporal region s is such that s occupies_spatiotemporal_region s. (axiom label in BFO2 Reference: [107-002])</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
