        <AbbreviatedIRI>obo:IAO_0000121</AbbreviatedIRI>
        <Literal xml:lang="en" datatypeIRI="&rdf;PlainLiteral">term created to ease viewing/sort terms for development purpose, and will not be included in a release</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
