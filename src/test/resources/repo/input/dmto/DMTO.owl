        <Literal xml:lang="en" datatypeIRI="&rdf;PlainLiteral">the length of the circumference of your waist</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000112"/>
