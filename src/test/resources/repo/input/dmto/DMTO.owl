        <AnnotationProperty abbreviatedIRI="obo:IAO_0000115"/>
        <AbbreviatedIRI>obo:IAO_0000123</AbbreviatedIRI>
        <Literal xml:lang="en" datatypeIRI="&rdf;PlainLiteral">Class is being worked on; however, the metadata (including definition) are not complete or sufficiently clear to the branch editors.</Literal>
