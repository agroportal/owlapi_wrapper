        </Annotation>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000601"/>
        <AbbreviatedIRI>obo:BFO_0000011</AbbreviatedIRI>
        <Literal xml:lang="en" datatypeIRI="&rdf;PlainLiteral">Each spatiotemporal region at any time t projects_onto some spatial region at t. (axiom label in BFO2 Reference: [099-001])</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <Annotation>
            <AnnotationProperty abbreviatedIRI="obo:IAO_0010000"/>
            <AbbreviatedIRI>obo:bfo/axiom/098-001</AbbreviatedIRI>
        </Annotation>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000601"/>
        <AbbreviatedIRI>obo:BFO_0000011</AbbreviatedIRI>
        <Literal xml:lang="en" datatypeIRI="&rdf;PlainLiteral">Each spatiotemporal region projects_onto some temporal region. (axiom label in BFO2 Reference: [098-001])</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000601"/>
