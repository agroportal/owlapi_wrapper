    <!-- http://purl.obolibrary.org/obo/HP_0040197 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0040197">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0012443"/>
        <obo:CIDO_0000009>脑软化</obo:CIDO_0000009>
        <obo:IAO_0000115>Encephalomalacia is the softening or loss of brain tissue after cerebral infarction, cerebral ischemia, infection, craniocerebral trauma, or other injury.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/hp.owl"/>
        <oboInOwl:created_by>PhenoTips:CHum</oboInOwl:created_by>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MSH:D004678</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SNOMEDCT_US:58762006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS:C0014068</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Cerebral softening</oboInOwl:hasExactSynonym>
        <rdfs:label>Encephalomalacia</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0100545 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0100545">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011004"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Narrowing or constriction of the inner surface (lumen) of an artery.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/hp.owl"/>
