                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_38637"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An aminopyrimidine that is 2-methylpyrimidine which is substituted at position 4 by the primary amino group of 2-amino-1,3-thiazole-5-carboxylic acid and at position 6 by a 4-(2-hydroxyethyl)piperazin-1-yl group, and in which the carboxylic acid group has been formally condensed with 2-chloro-6-methylaniline to afford the corresponding amide. A multi-targeted kinase inhibitor, it is used, particularly as the monohydrate, for the treatment of chronic, accelerated, or myeloid or lymphoid blast phase chronic myeloid leukemia. Note that the name &apos;dasatinib&apos; is used to refer to the monohydrate (USAN) as well as to anhydrous dasatinib (INN).</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/chebi.owl"/>
        <chebi:charge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">0</chebi:charge>
        <chebi:formula rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C22H26ClN7O2S</chebi:formula>
        <chebi:inchi rdf:datatype="http://www.w3.org/2001/XMLSchema#string">InChI=1S/C22H26ClN7O2S/c1-14-4-3-5-16(23)20(14)28-21(32)17-13-24-22(33-17)27-18-12-19(26-15(2)25-18)30-8-6-29(7-9-30)10-11-31/h3-5,12-13,31H,6-11H2,1-2H3,(H,28,32)(H,24,25,26,27)</chebi:inchi>
        <chebi:inchikey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ZBNZXTGUTAYRHI-UHFFFAOYSA-N</chebi:inchikey>
        <chebi:mass rdf:datatype="http://www.w3.org/2001/XMLSchema#string">488.00652</chebi:mass>
