        <NDF-RT:NUI>N0000002218</NDF-RT:NUI>
        <NDF-RT:Display_Name>Onchocerciasis</NDF-RT:Display_Name>
        <rdfs:label>Onchocerciasis [Disease/Finding]</rdfs:label>
        <NDF-RT:MeSH_Definition>Infection with nematodes of the genus ONCHOCERCA. Characteristics include the presence of firm subcutaneous nodules filled with adult worms, PRURITUS, and ocular lesions.</NDF-RT:MeSH_Definition>
        <NDF-RT:SNOMED_CID>38539003</NDF-RT:SNOMED_CID>
        <NDF-RT:RxNorm_CUI>984320</NDF-RT:RxNorm_CUI>
