        <chebi:monoisotopicmass rdf:datatype="http://www.w3.org/2001/XMLSchema#string">259.24258</chebi:monoisotopicmass>
        <chebi:smiles rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C12C(C3C(C(CC3)*)(C)CC1)CCC4C2(CCCC4)C</chebi:smiles>
