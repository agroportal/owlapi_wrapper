        <obo:UBPROP_0000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Portion of the dermis characterized by a well-arranged, plywood-like, collagenous network. Le Guellec et al, 2004.[TAO]</obo:UBPROP_0000001>
        <obo:UBPROP_0000002 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relationship loss: develops_from collagenous dermal stroma (TAO:0001186)[TAO]</obo:UBPROP_0000002>
        <obo:UBPROP_0000010 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">connective tissue in the skin is usually diffuse and irregular, although in some species collagen bundles are arranged in a distinct ordered layer in the dermis</obo:UBPROP_0000010>
