        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DRON_00000007"/>
        <obo:IAO_0000115 xml:lang="en">a portion of solution that is the bearer of a clinical drug role</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">William Hogan</obo:IAO_0000117>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/dron.owl"/>
        <dc:creator xml:lang="en">William Hogan</dc:creator>
        <rdfs:label xml:lang="en">drug solution</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DRON_00000022 -->

