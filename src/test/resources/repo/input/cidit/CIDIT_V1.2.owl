        <NDF-RT:MeSH_DUI>D005663</NDF-RT:MeSH_DUI>
        <obo:IAO_0000412 rdf:resource="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl"/>
        <NDF-RT:MeSH_Definition>Compounds with a 5-membered ring of four carbons and an oxygen. They are aromatic heterocycles. The reduced form is tetrahydrofuran.</NDF-RT:MeSH_Definition>
        <NDF-RT:UMLS_CUI>C0016850</NDF-RT:UMLS_CUI>
        <NDF-RT:NUI>N0000007775</NDF-RT:NUI>
