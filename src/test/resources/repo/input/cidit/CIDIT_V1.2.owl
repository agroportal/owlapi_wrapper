    </owl:Class>
    


    <!-- http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl#N0000007182 -->

    <owl:Class rdf:about="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl#N0000007182">
        <rdfs:subClassOf rdf:resource="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl#N0000007962"/>
