        <NDF-RT:MeSH_DUI>D017445</NDF-RT:MeSH_DUI>
        <NDF-RT:SNOMED_CID>11263005</NDF-RT:SNOMED_CID>
    </rdf:Description>
    <rdf:Description rdf:about="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl#N0000003620">
        <NDF-RT:MeSH_Definition>A heterogeneous group of disorders with the common feature of prolonged eosinophilia of unknown cause and associated organ system dysfunction, including the heart, central nervous system, kidneys, lungs, gastrointestinal tract, and skin. There is a massive increase in the number of eosinophils in the blood, mimicking leukemia, and extensive eosinophilic infiltration of the various organs. It is often referred to as idiopathic.</NDF-RT:MeSH_Definition>
        <NDF-RT:NUI>N0000003620</NDF-RT:NUI>
        <obo:IAO_0000412 rdf:resource="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl"/>
