    <!-- http://purl.obolibrary.org/obo/HP_0002013 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0002013">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0002017"/>
        <obo:CIDO_0000009>呕吐</obo:CIDO_0000009>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Forceful ejection of the contents of the stomach through the mouth by means of a series of involuntary spasmic contractions.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/hp.owl"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MEDDRA:10047700</oboInOwl:hasDbXref>
