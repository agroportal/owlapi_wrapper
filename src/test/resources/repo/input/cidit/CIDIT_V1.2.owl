        <NDF-RT:MeSH_DUI>D012221</NDF-RT:MeSH_DUI>
        <NDF-RT:Synonym>Rhinitis, Allergic, Nonseasonal</NDF-RT:Synonym>
        <NDF-RT:MeSH_CUI>M0019020</NDF-RT:MeSH_CUI>
        <NDF-RT:SNOMED_CID>38103000</NDF-RT:SNOMED_CID>
        <rdfs:label>Rhinitis, Allergic, Perennial [Disease/Finding]</rdfs:label>
        <NDF-RT:MeSH_Definition>Inflammation of the mucous membrane of the nose similar to that found in hay fever except that symptoms persist throughout the year. The causes are usually air-borne allergens, particularly dusts, feathers, molds, animal fur, etc.</NDF-RT:MeSH_Definition>
    </rdf:Description>
