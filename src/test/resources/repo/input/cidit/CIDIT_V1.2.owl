        <rdfs:label xml:lang="en">filtration</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0302886 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0302886">
