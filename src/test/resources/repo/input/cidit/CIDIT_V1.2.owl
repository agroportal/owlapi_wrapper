        <NDF-RT:RxNorm_CUI>35255</NDF-RT:RxNorm_CUI>
        <NDF-RT:MeSH_Name>Cisapride</NDF-RT:MeSH_Name>
        <NDF-RT:MeSH_DUI>D020117</NDF-RT:MeSH_DUI>
        <NDF-RT:MeSH_Definition>A substituted benzamide used for its prokinetic properties. It is used in the management of gastroesophageal reflux disease, functional dyspepsia, and other disorders associated with impaired gastrointestinal motility. (Martindale The Extra Pharmacopoeia, 31st ed)</NDF-RT:MeSH_Definition>
        <NDF-RT:NUI>N0000006590</NDF-RT:NUI>
        <NDF-RT:UMLS_CUI>C0072916</NDF-RT:UMLS_CUI>
        <NDF-RT:MeSH_CUI>M0029858</NDF-RT:MeSH_CUI>
