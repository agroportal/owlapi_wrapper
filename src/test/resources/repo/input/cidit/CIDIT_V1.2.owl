        <NDF-RT:code>C4872</NDF-RT:code>
        <rdfs:label>Pemphigus [Disease/Finding]</rdfs:label>
        <NDF-RT:MeSH_Definition>Group of chronic blistering diseases characterized histologically by ACANTHOLYSIS and blister formation within the EPIDERMIS.</NDF-RT:MeSH_Definition>
        <NDF-RT:Display_Name>Pemphigus</NDF-RT:Display_Name>
    </rdf:Description>
    <rdf:Description rdf:about="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl#N0000002351">
        <rdfs:label>Peptic Ulcer [Disease/Finding]</rdfs:label>
        <NDF-RT:MeSH_Definition>Ulcer that occurs in the regions of the GASTROINTESTINAL TRACT which come into contact with GASTRIC JUICE containing PEPSIN and GASTRIC ACID. It occurs when there are defects in the MUCOSA barrier. The common forms of peptic ulcers are associated with HELICOBACTER PYLORI and the consumption of nonsteroidal anti-inflammatory drugs (NSAIDS).</NDF-RT:MeSH_Definition>
        <NDF-RT:MeSH_CUI>M0016211</NDF-RT:MeSH_CUI>
        <NDF-RT:MeSH_DUI>D010437</NDF-RT:MeSH_DUI>
        <obo:IAO_0000412 rdf:resource="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl"/>
        <NDF-RT:SNOMED_CID>196697002</NDF-RT:SNOMED_CID>
