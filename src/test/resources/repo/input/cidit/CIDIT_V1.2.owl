        <NDF-RT:RxNorm_CUI>1022871</NDF-RT:RxNorm_CUI>
        <NDF-RT:MeSH_Definition>Disorder caused by motion, as sea sickness, train sickness, car sickness, air sickness, or SPACE MOTION SICKNESS. It may include nausea, vomiting and dizziness.</NDF-RT:MeSH_Definition>
        <NDF-RT:SNOMED_CID>269278001</NDF-RT:SNOMED_CID>
        <rdfs:label>Motion Sickness [Disease/Finding]</rdfs:label>
