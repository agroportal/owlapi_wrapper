    <rdf:Description rdf:about="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl#N0000000807">
        <NDF-RT:Synonym>Ulcerative Colitis</NDF-RT:Synonym>
        <obo:IAO_0000412 rdf:resource="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl"/>
        <NDF-RT:SNOMED_CID>64766004</NDF-RT:SNOMED_CID>
        <NDF-RT:RxNorm_CUI>1025158</NDF-RT:RxNorm_CUI>
