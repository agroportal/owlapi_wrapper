        <rdfs:label>Carboxylic Acids [Chemical/Ingredient]</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl#N0000008140">
        <NDF-RT:MeSH_Definition>The aglycone constituents of CARDIAC GLYCOSIDES. The ring structure is basically a cyclopentanoperhydrophenanthrene nucleus attached to a lactone ring at the C-17 position.</NDF-RT:MeSH_Definition>
        <rdfs:label>Cardanolides [Chemical/Ingredient]</rdfs:label>
