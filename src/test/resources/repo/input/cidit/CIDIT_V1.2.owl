    <!-- http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl#N0000007109 -->

    <owl:Class rdf:about="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl#N0000007109">
