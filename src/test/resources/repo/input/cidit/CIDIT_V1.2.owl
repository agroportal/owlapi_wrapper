        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35488"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A central nervous system depressant used to induce drowsiness or sleep or to reduce psychological excitement or anxiety.</obo:IAO_0000115>
