    <rdf:Description rdf:about="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl#N0000002347">
        <obo:IAO_0000412 rdf:resource="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl"/>
        <NDF-RT:MeSH_Name>Pemphigus</NDF-RT:MeSH_Name>
        <NDF-RT:RxNorm_CUI>1025707</NDF-RT:RxNorm_CUI>
        <NDF-RT:SNOMED_CID>65172003</NDF-RT:SNOMED_CID>
        <NDF-RT:MeSH_DUI>D010392</NDF-RT:MeSH_DUI>
        <NDF-RT:MeSH_CUI>M0016112</NDF-RT:MeSH_CUI>
