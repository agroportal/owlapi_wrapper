    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ICDO_0000082">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001062"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/icdo.owl"/>
        <rdfs:label xml:lang="en">pathological anatomical entity</rdfs:label>
    </owl:Class>
    


