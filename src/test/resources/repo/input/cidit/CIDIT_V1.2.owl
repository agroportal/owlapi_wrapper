        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/uberon/core#uberon_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/uberon/core#vertebrate_core"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">paraxial mesoderm</rdfs:label>
        <foaf:depicted_by rdf:resource="http://upload.wikimedia.org/wikipedia/commons/6/64/Gray19_with_color.png"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0003081 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0003081">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004120"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005291"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007524"/>
