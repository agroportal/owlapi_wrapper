        <chebi:formula rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C13H6Cl6O2</chebi:formula>
        <chebi:inchi rdf:datatype="http://www.w3.org/2001/XMLSchema#string">InChI=1S/C13H6Cl6O2/c14-6-2-8(16)12(20)4(10(6)18)1-5-11(19)7(15)3-9(17)13(5)21/h2-3,20-21H,1H2</chebi:inchi>
