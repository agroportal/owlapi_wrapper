        <oboInOwl:hasExactSynonym>Heart palpitations</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Missed heart beat</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Palpitations</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Skipped heart beat</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">human_phenotype</oboInOwl:hasOBONamespace>
