        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
        <obo:UBPROP_0000003 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">(In vertebrates) The embryonic mesoderm is the source of both the cardiogenic plate, giving rise to the future myocardium as well as the endocardium that will line the system on the inner side.[well established][VHOG]</obo:UBPROP_0000003>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EHDAA2:0000215</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EMAPA:16106</oboInOwl:hasDbXref>
