    <rdf:Description rdf:about="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl#N0000000469">
        <NDF-RT:Synonym>Arrythmia</NDF-RT:Synonym>
        <NDF-RT:code>C1116</NDF-RT:code>
        <NDF-RT:UMLS_CUI>C0003811</NDF-RT:UMLS_CUI>
        <NDF-RT:Display_Name>Arrhythmias, Cardiac</NDF-RT:Display_Name>
        <NDF-RT:MeSH_Name>Arrhythmias, Cardiac</NDF-RT:MeSH_Name>
        <NDF-RT:Synonym>Cardiac Arrhythmias</NDF-RT:Synonym>
        <NDF-RT:MeSH_CUI>M0001715</NDF-RT:MeSH_CUI>
        <NDF-RT:Synonym>Cardiac Arrhythmia</NDF-RT:Synonym>
        <NDF-RT:MeSH_Definition>Any disturbances of the normal rhythmic beating of the heart or MYOCARDIAL CONTRACTION. Cardiac arrhythmias can be classified by the abnormalities in HEART RATE, disorders of electrical impulse generation, or impulse conduction.</NDF-RT:MeSH_Definition>
