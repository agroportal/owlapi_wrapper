        <NDF-RT:Synonym>Parkinsonism</NDF-RT:Synonym>
        <NDF-RT:UMLS_CUI>C0242422</NDF-RT:UMLS_CUI>
        <NDF-RT:code>C8514</NDF-RT:code>
        <obo:IAO_0000412 rdf:resource="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl"/>
        <rdfs:label>Parkinsonian Disorders [Disease/Finding]</rdfs:label>
    </owl:Class>
    


