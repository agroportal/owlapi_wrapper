        <NDF-RT:Synonym>Fatty Liver with Encephalopathy</NDF-RT:Synonym>
        <NDF-RT:MeSH_Name>Reye Syndrome</NDF-RT:MeSH_Name>
        <NDF-RT:Display_Name>Reye Syndrome</NDF-RT:Display_Name>
        <NDF-RT:MeSH_CUI>M0018992</NDF-RT:MeSH_CUI>
        <NDF-RT:SNOMED_CID>74351001</NDF-RT:SNOMED_CID>
        <NDF-RT:RxNorm_CUI>1026604</NDF-RT:RxNorm_CUI>
        <NDF-RT:NUI>N0000002624</NDF-RT:NUI>
        <NDF-RT:Synonym>Reye&apos;s Syndrome</NDF-RT:Synonym>
        <NDF-RT:MeSH_Definition>A form of encephalopathy with fatty infiltration of the LIVER, characterized by brain EDEMA and VOMITING that may rapidly progress to SEIZURES; COMA; and DEATH. It is caused by a generalized loss of mitochondrial function leading to disturbances in fatty acid and CARNITINE metabolism.</NDF-RT:MeSH_Definition>
        <NDF-RT:UMLS_CUI>C0035400</NDF-RT:UMLS_CUI>
        <NDF-RT:code>C5426</NDF-RT:code>
        <rdfs:label>Reye Syndrome [Disease/Finding]</rdfs:label>
        <NDF-RT:Synonym>Reye-Johnson Syndrome</NDF-RT:Synonym>
        <obo:IAO_0000412 rdf:resource="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl"/>
    </rdf:Description>
