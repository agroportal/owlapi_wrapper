    <!-- http://purl.obolibrary.org/obo/uberon/core#in_central_side_of -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/uberon/core#in_central_side_of">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">X in_central_side Y &lt;=&gt; if Y is subdivided into left and right portions around some median divisor, all parts of X are closer to the median divisor than the outermost lateral sides.</obo:IAO_0000115>
