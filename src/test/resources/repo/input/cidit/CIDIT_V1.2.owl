        <NDF-RT:code>CMSHM0507131</NDF-RT:code>
        <obo:IAO_0000412 rdf:resource="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl"/>
        <rdfs:label>Echinocandins [Chemical/Ingredient]</rdfs:label>
    </owl:Class>
    


