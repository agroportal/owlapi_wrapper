        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deficiency of thyroid hormone.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/hp.owl"/>
        <oboInOwl:hasAlternativeId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HP:0003222</oboInOwl:hasAlternativeId>
