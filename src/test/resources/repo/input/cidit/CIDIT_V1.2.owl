        <NDF-RT:UMLS_CUI>C0034140</NDF-RT:UMLS_CUI>
        <NDF-RT:MeSH_Name>Purines</NDF-RT:MeSH_Name>
        <rdfs:label>Purines [Chemical/Ingredient]</rdfs:label>
        <NDF-RT:NUI>N0000008065</NDF-RT:NUI>
        <NDF-RT:MeSH_CUI>M0018169</NDF-RT:MeSH_CUI>
        <NDF-RT:RxNorm_CUI>8952</NDF-RT:RxNorm_CUI>
        <NDF-RT:MeSH_Definition>A series of heterocyclic compounds that are variously substituted in nature and are known also as purine bases. They include ADENINE and GUANINE, constituents of nucleic acids, as well as many alkaloids such as CAFFEINE and THEOPHYLLINE. Uric acid is the metabolic end product of purine metabolism.</NDF-RT:MeSH_Definition>
        <NDF-RT:Display_Name>Purines</NDF-RT:Display_Name>
        <NDF-RT:code>C26494</NDF-RT:code>
        <obo:IAO_0000412 rdf:resource="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl"/>
    </rdf:Description>
