        <NDF-RT:Synonym>Leukemia, Myeloid, Ph1-Positive</NDF-RT:Synonym>
        <NDF-RT:Synonym>Leukemia, Myeloid, Philadelphia Positive</NDF-RT:Synonym>
        <NDF-RT:Synonym>Leukemia, Myeloid, Philadelphia-Positive</NDF-RT:Synonym>
        <NDF-RT:Synonym>Myelocytic Leukemia, Chronic</NDF-RT:Synonym>
