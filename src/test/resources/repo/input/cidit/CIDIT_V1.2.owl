    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DRON_00000028 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DRON_00000028">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DRON_00000030"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:allValuesFrom>
                    <owl:Class>
