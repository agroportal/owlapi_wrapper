    <rdf:Description rdf:about="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl#N0000004102">
        <NDF-RT:Display_Name>Intracranial Hemorrhages</NDF-RT:Display_Name>
        <NDF-RT:MeSH_DUI>D020300</NDF-RT:MeSH_DUI>
        <NDF-RT:RxNorm_CUI>1026294</NDF-RT:RxNorm_CUI>
        <NDF-RT:MeSH_Name>Intracranial Hemorrhages</NDF-RT:MeSH_Name>
        <obo:IAO_0000412 rdf:resource="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl"/>
        <NDF-RT:MeSH_Definition>Bleeding within the SKULL, including hemorrhages in the brain and the three membranes of MENINGES. The escape of blood often leads to the formation of HEMATOMA in the cranial epidural, subdural, and subarachnoid spaces.</NDF-RT:MeSH_Definition>
        <NDF-RT:Synonym>Hemorrhage, Intracranial</NDF-RT:Synonym>
        <NDF-RT:UMLS_CUI>C0151699</NDF-RT:UMLS_CUI>
        <rdfs:label>Intracranial Hemorrhages [Disease/Finding]</rdfs:label>
