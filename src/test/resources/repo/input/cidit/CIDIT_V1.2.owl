    <!-- http://purl.obolibrary.org/obo/UBERON_0003075 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0003075">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005291"/>
