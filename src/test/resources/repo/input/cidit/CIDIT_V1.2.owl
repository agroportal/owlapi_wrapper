        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000115 xml:lang="en">A process by which a disorder comes into existence.</obo:IAO_0000115>
        <obo:IAO_0000117>Albert Goldfain</obo:IAO_0000117>
        <obo:IAO_0000117>Alexander Diehl</obo:IAO_0000117>
        <obo:IAO_0000117>Lindsay Cowell</obo:IAO_0000117>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/ido.owl"/>
        <rdfs:label xml:lang="en">appearance of disorder</rdfs:label>
    </owl:Class>
    


