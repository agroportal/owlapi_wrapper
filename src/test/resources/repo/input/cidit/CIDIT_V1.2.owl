        <NDF-RT:Synonym>Erythromycin A</NDF-RT:Synonym>
        <NDF-RT:UMLS_CUI>C0014806</NDF-RT:UMLS_CUI>
        <NDF-RT:code>C24618</NDF-RT:code>
        <obo:IAO_0000412 rdf:resource="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl"/>
        <rdfs:label>Erythromycin [Chemical/Ingredient]</rdfs:label>
    </owl:Class>
    


    <!-- http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl#N0000007176 -->

    <owl:Class rdf:about="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl#N0000007176">
