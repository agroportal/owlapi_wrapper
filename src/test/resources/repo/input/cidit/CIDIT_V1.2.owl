        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/uberon/core#vertebrate_core"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sclerotome</rdfs:label>
        <foaf:depicted_by rdf:resource="http://upload.wikimedia.org/wikipedia/commons/9/96/Gray65.png"/>
