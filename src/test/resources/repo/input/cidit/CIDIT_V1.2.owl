        <NDF-RT:code>C24282</NDF-RT:code>
        <obo:IAO_0000412 rdf:resource="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl"/>
        <rdfs:label>Flecainide [Chemical/Ingredient]</rdfs:label>
    </owl:Class>
    


    <!-- http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl#N0000006978 -->

