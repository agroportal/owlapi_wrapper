        <NDF-RT:UMLS_CUI>C0008286</NDF-RT:UMLS_CUI>
        <NDF-RT:code>C24244</NDF-RT:code>
        <obo:IAO_0000412 rdf:resource="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl"/>
        <rdfs:label>Chlorpromazine [Chemical/Ingredient]</rdfs:label>
    </owl:Class>
    


    <!-- http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl#N0000006966 -->

    <owl:Class rdf:about="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl#N0000006966">
        <rdfs:subClassOf rdf:resource="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl#N0000007929"/>
