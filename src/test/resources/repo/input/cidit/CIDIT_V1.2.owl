        <NDF-RT:NUI>N0000003804</NDF-RT:NUI>
        <NDF-RT:UMLS_CUI>C0206754</NDF-RT:UMLS_CUI>
        <NDF-RT:Display_Name>Neuroendocrine Tumors</NDF-RT:Display_Name>
        <rdfs:label>Neuroendocrine Tumors [Disease/Finding]</rdfs:label>
        <NDF-RT:MeSH_Definition>Tumors whose cells possess secretory granules and originate from the neuroectoderm, i.e., the cells of the ectoblast or epiblast that program the neuroendocrine system. Common properties across most neuroendocrine tumors include ectopic hormone production (often via APUD CELLS), the presence of tumor-associated antigens, and isozyme composition.</NDF-RT:MeSH_Definition>
        <NDF-RT:MeSH_DUI>D018358</NDF-RT:MeSH_DUI>
        <NDF-RT:SNOMED_CID>255046005</NDF-RT:SNOMED_CID>
