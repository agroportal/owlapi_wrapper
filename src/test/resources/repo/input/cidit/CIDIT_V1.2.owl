    <!-- http://purl.obolibrary.org/obo/UBERON_0004140 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0004140">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004120"/>
