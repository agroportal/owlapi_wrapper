        <NDF-RT:NUI>N0000001018</NDF-RT:NUI>
        <NDF-RT:MeSH_DUI>D004405</NDF-RT:MeSH_DUI>
        <NDF-RT:MeSH_CUI>M0006916</NDF-RT:MeSH_CUI>
        <NDF-RT:code>C2214</NDF-RT:code>
        <NDF-RT:MeSH_Definition>DYSENTERY caused by gram-negative rod-shaped enteric bacteria (ENTEROBACTERIACEAE), most often by the genus SHIGELLA. Shigella dysentery, Shigellosis, is classified into subgroups according to syndrome severity and the infectious species. Group A: SHIGELLA DYSENTERIAE (severest); Group B: SHIGELLA FLEXNERI; Group C: SHIGELLA BOYDII; and Group D: SHIGELLA SONNEI (mildest).</NDF-RT:MeSH_Definition>
        <NDF-RT:Display_Name>Dysentery, Bacillary</NDF-RT:Display_Name>
        <rdfs:label>Dysentery, Bacillary [Disease/Finding]</rdfs:label>
