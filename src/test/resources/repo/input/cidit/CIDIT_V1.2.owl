        <chebi:inchikey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NCDNCNXCDXHOMX-XGKFQTDJSA-N</chebi:inchikey>
        <chebi:mass rdf:datatype="http://www.w3.org/2001/XMLSchema#string">720.94400</chebi:mass>
