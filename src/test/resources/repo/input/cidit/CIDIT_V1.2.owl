    </rdf:Description>
    <rdf:Description rdf:about="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl#N0000008096">
        <NDF-RT:MeSH_DUI>D006575</NDF-RT:MeSH_DUI>
        <NDF-RT:RxNorm_CUI>5286</NDF-RT:RxNorm_CUI>
