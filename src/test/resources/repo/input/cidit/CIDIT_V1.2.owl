        <NDF-RT:SNOMED_CID>360419005</NDF-RT:SNOMED_CID>
        <NDF-RT:MeSH_DUI>D017229</NDF-RT:MeSH_DUI>
        <obo:IAO_0000412 rdf:resource="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl"/>
        <NDF-RT:Display_Name>Enterobiasis</NDF-RT:Display_Name>
    </rdf:Description>
    <rdf:Description rdf:about="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl#N0000003578">
        <NDF-RT:Display_Name>Skin Diseases, Vascular</NDF-RT:Display_Name>
        <NDF-RT:MeSH_Definition>Skin diseases affecting or involving the cutaneous blood vessels and generally manifested as inflammation, swelling, erythema, or necrosis in the affected area.</NDF-RT:MeSH_Definition>
        <NDF-RT:MeSH_CUI>M0026469</NDF-RT:MeSH_CUI>
        <NDF-RT:Synonym>Vascular Skin Diseases</NDF-RT:Synonym>
        <NDF-RT:RxNorm_CUI>1024271</NDF-RT:RxNorm_CUI>
        <NDF-RT:MeSH_Name>Skin Diseases, Vascular</NDF-RT:MeSH_Name>
        <rdfs:label>Skin Diseases, Vascular [Disease/Finding]</rdfs:label>
        <NDF-RT:code>C7334</NDF-RT:code>
        <NDF-RT:NUI>N0000003578</NDF-RT:NUI>
        <obo:IAO_0000412 rdf:resource="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl"/>
