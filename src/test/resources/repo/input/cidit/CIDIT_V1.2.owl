        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/oae.owl"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/ogms.owl"/>
        <rdfs:label>pathological bodily process</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OGMS_0000063 -->

