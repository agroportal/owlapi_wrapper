                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">a solid object typically of discoid, spheroid, or elliptic-cylindrical shape or approximations thereof, that bears a clinical drug role.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">William Hogan</obo:IAO_0000117>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/dron.owl"/>
        <dc:creator xml:lang="en">William Hogan</dc:creator>
        <rdfs:label xml:lang="en">drug tablet</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DRON_00000026 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DRON_00000026">
