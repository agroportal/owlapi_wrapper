        <obo:IAO_0000412 rdf:resource="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl"/>
        <NDF-RT:Synonym>Adult Respiratory Distress Syndrome</NDF-RT:Synonym>
        <NDF-RT:Synonym>ARDS, Human</NDF-RT:Synonym>
        <NDF-RT:MeSH_Definition>A syndrome characterized by progressive life-threatening RESPIRATORY INSUFFICIENCY in the absence of known LUNG DISEASES, usually following a systemic insult such as surgery or major TRAUMA.</NDF-RT:MeSH_Definition>
