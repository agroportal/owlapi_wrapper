        <obo:IAO_0000115 xml:lang="en">an object that is the bearer of a drug role and is comprised of a solid shell of elliptical-cylindrical shape and another object contained in the shell that has a scattered molecular aggregate as a proper part</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">William Hogan</obo:IAO_0000117>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/dron.owl"/>
