        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBCS_0000218"/>
        <obo:IAO_0000115>A data item that is derived from an inferential statistical data analysis.</obo:IAO_0000115>
        <obo:IAO_0000117>Jie Zheng, Yongqun He</obo:IAO_0000117>
        <obo:IAO_0000118>inferential statistic</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://psc.dss.ucdavis.edu/sommerb/sommerdemo/stat_inf/intro.htm</obo:IAO_0000119>
        <obo:IAO_0000119>WEB: http://www.ask.com/question/what-is-numerical-data</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/obcs.owl"/>
        <rdfs:label xml:lang="en">derived data from inferential statistical analysis</rdfs:label>
