        <NDF-RT:Synonym>Ethanamine, 2-(4-(1,2-diphenyl-1-butenyl)phenoxy)-N,N-dimethyl-, (Z)-</NDF-RT:Synonym>
        <NDF-RT:UMLS_CUI>C0039286</NDF-RT:UMLS_CUI>
        <NDF-RT:code>C24432</NDF-RT:code>
        <obo:IAO_0000412 rdf:resource="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl"/>
        <rdfs:label>Tamoxifen [Chemical/Ingredient]</rdfs:label>
    </owl:Class>
    


