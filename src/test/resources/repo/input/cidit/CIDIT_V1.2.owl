        <NDF-RT:UMLS_CUI>C0035457</NDF-RT:UMLS_CUI>
        <NDF-RT:NUI>N0000002635</NDF-RT:NUI>
        <NDF-RT:Display_Name>Rhinitis, Allergic, Perennial</NDF-RT:Display_Name>
