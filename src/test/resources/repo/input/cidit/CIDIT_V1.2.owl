        <chebi:inchikey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPNSFSBZBAHARI-RUDMXATFSA-N</chebi:inchikey>
        <chebi:mass rdf:datatype="http://www.w3.org/2001/XMLSchema#string">320.33710</chebi:mass>
        <chebi:monoisotopicmass rdf:datatype="http://www.w3.org/2001/XMLSchema#string">320.12599</chebi:monoisotopicmass>
