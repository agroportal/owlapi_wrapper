    <!-- http://purl.obolibrary.org/obo/CHEBI_35473 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35473">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35471"/>
