    <!-- http://purl.obolibrary.org/obo/OAE_0001788 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/OAE_0001788">
        <obo:IAO_0000112>An adverse event has a participant quality, such as a hyperkalemia AE has a participatn quality blood potassium increased.</obo:IAO_0000112>
        <obo:IAO_0000115>an object property that represents a relation between a process and a quality, in which the process has a participant that has the quality.</obo:IAO_0000115>
        <obo:IAO_0000116>This is a shortcut relation of the following full version: 
&apos;has participant&apos; some (participant &apos;has quality&apos; )
in: process &apos;has participant&apos; some (participant &apos;has quality&apos; some quality)</obo:IAO_0000116>
        <obo:IAO_0000117>Yongqun He</obo:IAO_0000117>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/oae.owl"/>
        <rdfs:label xml:lang="en">has participant quality</rdfs:label>
    </owl:ObjectProperty>
    


