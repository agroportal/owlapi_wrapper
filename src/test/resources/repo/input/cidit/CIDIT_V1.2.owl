    <!-- http://purl.obolibrary.org/obo/CHEBI_57248 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_57248">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_46895"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_86478"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Any one of a family of large lipopeptides that are inhibitors of the enzyme 1,3-beta-glucan synthase, thus damaging fungal cell walls. Echinocandins are fungicidal against most Candida spp and fungistatic against Aspergillus spp.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/chebi.owl"/>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">echinocandins</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHEBI:57248</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/chebi#3_STAR"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">echinocandin</rdfs:label>
    </owl:Class>
    


