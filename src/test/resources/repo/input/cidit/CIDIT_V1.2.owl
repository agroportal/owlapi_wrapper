    <rdf:Description rdf:about="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl#N0000167259">
        <NDF-RT:Synonym>Banisterine</NDF-RT:Synonym>
        <NDF-RT:Synonym>Yageine</NDF-RT:Synonym>
        <NDF-RT:MeSH_Definition>Alkaloid isolated from seeds of Peganum harmala L., Zygophyllaceae. It is identical to banisterine, or telepathine, from Banisteria caapi and is one of the active ingredients of hallucinogenic drinks made in the western Amazon region from related plants. It has no therapeutic use, but (as banisterine) was hailed as a cure for postencephalitic Parkinson disease in the 1920&apos;s.</NDF-RT:MeSH_Definition>
        <NDF-RT:MeSH_Name>Harmine</NDF-RT:MeSH_Name>
        <NDF-RT:MeSH_DUI>D006247</NDF-RT:MeSH_DUI>
        <NDF-RT:code>C7758364911462</NDF-RT:code>
        <NDF-RT:RxNorm_CUI>5101</NDF-RT:RxNorm_CUI>
