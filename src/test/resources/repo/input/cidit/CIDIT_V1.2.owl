        <NDF-RT:code>C23096</NDF-RT:code>
        <obo:IAO_0000412 rdf:resource="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl"/>
        <rdfs:label>Ivermectin [Chemical/Ingredient]</rdfs:label>
    </owl:Class>
    


