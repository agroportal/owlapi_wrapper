    <rdf:Description rdf:about="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl#N0000000488">
        <obo:IAO_0000412 rdf:resource="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl"/>
        <NDF-RT:MeSH_CUI>M0001785</NDF-RT:MeSH_CUI>
        <NDF-RT:MeSH_Definition>Infection by nematodes of the genus ASCARIS. Ingestion of infective eggs causes diarrhea and pneumonitis. Its distribution is more prevalent in areas of poor sanitation and where human feces are used for fertilizer.</NDF-RT:MeSH_Definition>
        <rdfs:label>Ascariasis [Disease/Finding]</rdfs:label>
        <NDF-RT:MeSH_DUI>D001196</NDF-RT:MeSH_DUI>
        <NDF-RT:UMLS_CUI>C0003950</NDF-RT:UMLS_CUI>
        <NDF-RT:Display_Name>Ascariasis</NDF-RT:Display_Name>
        <NDF-RT:NUI>N0000000488</NDF-RT:NUI>
