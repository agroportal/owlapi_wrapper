    <rdf:Description rdf:about="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl#N0000001353">
        <NDF-RT:Synonym>Glomerulonephritis, Focal Sclerosing</NDF-RT:Synonym>
        <NDF-RT:MeSH_Definition>A clinicopathological syndrome or diagnostic term for a type of glomerular injury that has multiple causes, primary or secondary. Clinical features include PROTEINURIA, reduced GLOMERULAR FILTRATION RATE, and EDEMA. Kidney biopsy initially indicates focal segmental glomerular consolidation (hyalinosis) or scarring which can progress to globally sclerotic glomeruli leading to eventual KIDNEY FAILURE.</NDF-RT:MeSH_Definition>
        <NDF-RT:MeSH_DUI>D005923</NDF-RT:MeSH_DUI>
        <rdfs:label>Glomerulosclerosis, Focal Segmental [Disease/Finding]</rdfs:label>
        <NDF-RT:code>C2884</NDF-RT:code>
        <NDF-RT:SNOMED_CID>25821008</NDF-RT:SNOMED_CID>
        <NDF-RT:Synonym>Glomerulosclerosis, Focal</NDF-RT:Synonym>
