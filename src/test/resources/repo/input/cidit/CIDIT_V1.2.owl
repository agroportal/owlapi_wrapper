    </rdf:Description>
    <rdf:Description rdf:about="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl#N0000006461">
        <NDF-RT:MeSH_Name>Bepridil</NDF-RT:MeSH_Name>
        <rdfs:label>Bepridil [Chemical/Ingredient]</rdfs:label>
        <NDF-RT:MeSH_DUI>D015764</NDF-RT:MeSH_DUI>
        <obo:IAO_0000412 rdf:resource="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl"/>
        <NDF-RT:MeSH_Definition>A long-acting calcium-blocking agent with significant anti-anginal activity. The drug produces significant coronary vasodilation and modest peripheral effects. It has antihypertensive and selective anti-arrhythmia activities and acts as a calmodulin antagonist.</NDF-RT:MeSH_Definition>
        <NDF-RT:UMLS_CUI>C0005116</NDF-RT:UMLS_CUI>
