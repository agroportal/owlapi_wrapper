        <NDF-RT:Synonym>6-Methylcompactin</NDF-RT:Synonym>
        <NDF-RT:Synonym>Butanoic acid, 2-methyl-, 1,2,3,7,8,8a-hexahydro-3,7-dimethyl-8-(2-(tetrahydro-4-hydroxy-6-oxo-2H-pyran-2-yl)ethyl)-1-naphthalenyl ester, (1S-(1alpha(R*),3alpha,7beta,8beta(2S*,4S*),8abeta))-</NDF-RT:Synonym>
        <NDF-RT:Synonym>Mevinolin</NDF-RT:Synonym>
        <NDF-RT:Synonym>Monacolin K</NDF-RT:Synonym>
        <NDF-RT:UMLS_CUI>C0024027</NDF-RT:UMLS_CUI>
        <NDF-RT:code>C24564</NDF-RT:code>
        <obo:IAO_0000412 rdf:resource="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl"/>
