    <!-- http://purl.obolibrary.org/obo/CHEBI_25944 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_25944">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33232"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Strictly, a substance intended to kill pests. In common usage, any substance used for controlling, preventing, or destroying animal, microbiological or plant pests.</obo:IAO_0000115>
