        <obo:IAO_0000111 xml:lang="en">enzymatic amplification</obo:IAO_0000111>
        <obo:IAO_0000112 xml:lang="en">the use of a polymerase chain reaction to amplify a fragment of DNA</obo:IAO_0000112>
