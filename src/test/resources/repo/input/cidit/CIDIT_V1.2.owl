    <!-- http://purl.obolibrary.org/obo/OBCS_0000233 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBCS_0000233">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
