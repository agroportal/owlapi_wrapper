    <!-- http://purl.obolibrary.org/obo/DRON_00000005 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DRON_00000005">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000040"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000053"/>
