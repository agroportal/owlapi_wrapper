        <NDF-RT:MeSH_CUI>M0017164</NDF-RT:MeSH_CUI>
        <NDF-RT:Display_Name>Polycyclic Hydrocarbons, Aromatic</NDF-RT:Display_Name>
        <NDF-RT:MeSH_Name>Polycyclic Hydrocarbons, Aromatic</NDF-RT:MeSH_Name>
        <NDF-RT:Synonym>Polycyclic Aromatic Hydrocarbons</NDF-RT:Synonym>
    </rdf:Description>
