    <rdf:Description rdf:about="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl#N0000001097">
        <NDF-RT:Synonym>Endocarditides, Bacterial</NDF-RT:Synonym>
        <NDF-RT:MeSH_Definition>Inflammation of the ENDOCARDIUM caused by BACTERIA that entered the bloodstream. The strains of bacteria vary with predisposing factors, such as CONGENITAL HEART DEFECTS; HEART VALVE DISEASES; HEART VALVE PROSTHESIS IMPLANTATION; or intravenous drug use.</NDF-RT:MeSH_Definition>
        <NDF-RT:MeSH_Name>Endocarditis, Bacterial</NDF-RT:MeSH_Name>
        <NDF-RT:SNOMED_CID>301183007</NDF-RT:SNOMED_CID>
