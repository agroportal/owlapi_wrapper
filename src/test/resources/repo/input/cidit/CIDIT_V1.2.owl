        <rdfs:subClassOf rdf:resource="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl#N0000002005"/>
        <rdfs:subClassOf rdf:resource="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl#N0000002765"/>
        <NDF-RT:Display_Name>Porphyrias</NDF-RT:Display_Name>
        <NDF-RT:MeSH_CUI>M0017334</NDF-RT:MeSH_CUI>
        <NDF-RT:MeSH_DUI>D011164</NDF-RT:MeSH_DUI>
        <NDF-RT:MeSH_Definition>A diverse group of metabolic diseases characterized by errors in the biosynthetic pathway of HEME in the LIVER, the BONE MARROW, or both. They are classified by the deficiency of specific enzymes, the tissue site of enzyme defect, or the clinical features that include neurological (acute) or cutaneous (skin lesions). Porphyrias can be hereditary or acquired as a result of toxicity to the hepatic or erythropoietic marrow tissues.</NDF-RT:MeSH_Definition>
        <NDF-RT:MeSH_Name>Porphyrias</NDF-RT:MeSH_Name>
        <NDF-RT:NUI>N0000002464</NDF-RT:NUI>
        <NDF-RT:RxNorm_CUI>1022410</NDF-RT:RxNorm_CUI>
        <NDF-RT:SNOMED_CID>29094004</NDF-RT:SNOMED_CID>
        <NDF-RT:SNOMED_CID>371628009</NDF-RT:SNOMED_CID>
        <NDF-RT:SNOMED_CID>418470004</NDF-RT:SNOMED_CID>
        <NDF-RT:Synonym>Porphyria</NDF-RT:Synonym>
        <NDF-RT:UMLS_CUI>C0032708</NDF-RT:UMLS_CUI>
        <NDF-RT:code>C5106</NDF-RT:code>
        <obo:IAO_0000412 rdf:resource="http://evs.nci.nih.gov/ftp1/NDF-RT/NDF-RT.owl"/>
        <rdfs:label>Porphyrias [Disease/Finding]</rdfs:label>
    </owl:Class>
    


