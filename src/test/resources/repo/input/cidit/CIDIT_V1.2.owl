                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_4705"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000809"/>
        <obo:IAO_0000111 xml:lang="en">PCR product</obo:IAO_0000111>
        <obo:IAO_0000112 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PCR products are the results of amplifcation process. Detection of a PCR products is used to detect DNA and RNA.</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000115 xml:lang="en">is double stranded DNA that is the specified output of a polymerase chain reaction</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">We are using PCR and not the written out words, as this is the most common used.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GROUP: OBI BIomaterial Branch</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GROUP: OBI BIomaterial Branch</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/obi.owl"/>
        <rdfs:label xml:lang="en">PCR product</rdfs:label>
    </owl:Class>
    


