        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/uberon/core#uberon_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/uberon/core#vertebrate_core"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">blood island</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0003068 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0003068">
