        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">superficial_to</oboInOwl:id>
        <oboInOwl:shorthand rdf:datatype="http://www.w3.org/2001/XMLSchema#string">superficial_to</oboInOwl:shorthand>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">superficial_to</rdfs:label>
    </owl:ObjectProperty>
    


