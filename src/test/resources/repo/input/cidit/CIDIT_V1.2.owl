        <rdfs:label>Endometriosis [Disease/Finding]</rdfs:label>
        <NDF-RT:UMLS_CUI>C0014175</NDF-RT:UMLS_CUI>
        <NDF-RT:Display_Name>Endometriosis</NDF-RT:Display_Name>
