        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/uberon/core#upper_level"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Old definition: &apos;Non-material anatomical entity of two dimensions, that is demarcated by anatomical lines or points on the external or internal surfaces of anatomical structures.&apos; Note, in the new definition, the space referred to is not necessarily an anatomical space. It may be the outside of an organism.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">anatomical surface</rdfs:label>
    </owl:Class>
    


